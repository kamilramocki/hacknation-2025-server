        {
          "name": "CreateWebsite",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('WebsiteId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "description": "Create a new website",
            "url": {
              "raw": "{{ApiUrl}}/websites",
              "protocol": "",
              "host": [
                "{{ApiUrl}}"
              ],
              "path": [
                "websites"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Google\",\n  \"domainAddresses\": [\"www.google.com\", \"mail.google.com\"],\n  \"ipAddresses\": [\"142.250.185.206\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
